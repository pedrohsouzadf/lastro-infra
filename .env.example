# Webhook do Apps Script que grava os leads no Google Sheets.
# Copie este arquivo para .env.local e preencha. Os mesmos dois valores
# precisam ser cadastrados em Vercel → Settings → Environment Variables.
#
# Sem prefixo NEXT_PUBLIC_ de propósito: estas variáveis só existem no
# servidor. Com o prefixo elas iriam para o bundle do browser e qualquer
# um poderia escrever na planilha.

SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
SHEETS_TOKEN=troque-por-uma-string-longa-e-aleatoria
